rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MEMBERSHIP IS CHECKED AGAINST `memberIds`, NOT `members` — READ THIS
    // BEFORE CHANGING ANY MEMBERSHIP CHECK IN THIS FILE.
    //
    // Every membership check in this file (and in storage.rules) used to be
    // spelled `householdData.members.filter(m => m.userId == request.auth.uid)
    // .size() > 0`. That is NOT valid Firestore Rules: the rules language's
    // List type exposes only concat/hasAll/hasAny/hasOnly/join/removeAll/
    // size/toSet — there is no filter(), and the language has no lambda /
    // anonymous-function syntax at all (named `function`s like these are
    // top-level rule helpers with concrete parameters; you cannot build an
    // inline predicate and pass it as a value). This was the foundation of
    // all access control across both plans and survived three hand-traced
    // security reviews only because no JRE/emulator has ever been available
    // in this sandbox to actually deploy the ruleset — every review traced
    // the LOGIC while assuming the SYNTAX was valid. Left in place it would
    // either fail the whole ruleset at deploy time or error on every
    // evaluation (which Firestore treats as a denial), i.e. lock every user
    // out of the entire app.
    //
    // Fix: the household document now carries a denormalized
    // `memberIds: string[]` alongside `members: HouseholdMember[]`, written
    // in lockstep by createHousehold/joinHousehold (see householdService.ts,
    // both writes are inside the same atomic batch). Membership is tested
    // with `request.auth.uid in householdData.memberIds` — the `in` operator
    // over a list of strings is standard, unambiguously documented rules
    // syntax. `members` is retained because the app needs displayName per
    // member for the UI; it is no longer consulted for authorization by any
    // rule, so the two arrays' only hard requirement is that memberIds stays
    // append-only and accurate (enforced for untrusted writes by isJoining
    // below).
    function isMember(householdData) {
      return request.auth != null &&
        request.auth.uid in householdData.memberIds;
    }

    // A non-member may update the document only to join it: the write must
    // add exactly one member (the requester) while every existing member
    // entry is still present unchanged. hasAll is what actually blocks a
    // hijack attempt — without it, a non-member could submit a whole new
    // members array that drops an existing member while still passing the
    // size(+1)-and-self-present checks alone (this was found and fixed
    // during review — see the plan's revision log).
    //
    // The diff().affectedKeys().hasOnly([...]) clause (added in a
    // later fix round) closes a second gap: without it, a joining write
    // could smuggle changes to any other field (name, inviteCode,
    // createdAt, ...) in the same updateDoc call, since the checks above
    // only ever look at the `members` array. NOTE: this specific
    // Map.diff()/MapDiff.affectedKeys() syntax could not be verified
    // against a running emulator in this environment (no JRE available) —
    // it matches Firestore rules-language documentation from training
    // knowledge, but should be confirmed with a real emulator run before
    // being trusted in production.
    //
    // The joinCodeUsed == householdData.inviteCode check (added in fix
    // round 3) closes the deepest gap found so far: everything above only
    // ever validated the SHAPE of the resulting members array — it never
    // verified the requester actually possesses the household's invite
    // code. Without this check, anyone who learns a household's raw
    // document ID (which every current/former member inherently knows,
    // since it's the app's own primary key) could call
    // updateDoc(households/{knownId}, {members: arrayUnion(self)}) directly
    // and join with zero knowledge of the real invite code, silently
    // defeating the invite-code system. joinHousehold (householdService.ts)
    // now writes a `joinCodeUsed` field alongside `members` carrying the
    // code the user typed in; this rule requires it to match the
    // household's OWN currently-stored `inviteCode` — readable here via
    // householdData.inviteCode even though the joining client has no read
    // grant on the document itself, because rules evaluate against the
    // document's actual stored data regardless of the requester's own read
    // access. `joinCodeUsed` is intentionally added to the diff-scope
    // allowlist (not just `members`) since the join write now legitimately
    // touches both fields; it is intentionally NOT widened further.
    //
    // The `memberIds` clauses (added in the final-review fix wave, same
    // change as the isMember rewrite above) replace the one line that used
    // the invalid `.filter(m => m.userId == request.auth.uid).size() == 1`
    // idiom — the "requester appears exactly once in the new members array"
    // check. The size(+1)/hasAll pair over `members` is UNCHANGED and still
    // provides the original eviction-hijack protection over the full member
    // -object array; the identical size(+1)/hasAll pair over `memberIds`
    // forces that array to gain exactly one new slot while every previously
    // present ID survives unchanged, and `request.auth.uid in
    // request.resource.data.memberIds` forces that one new slot to be the
    // requester's own ID. Together that is the same "adds exactly the
    // requester, nobody else, evicts nobody" guarantee the filter-based
    // check provided, expressed over the plain string array instead of the
    // object array. Requiring the checks on BOTH arrays is what keeps them
    // in lockstep: a write that grows only one of the two is denied, so
    // memberIds can never silently drift from members. `memberIds` is added
    // to the diff-scope allowlist for the same reason `joinCodeUsed` was —
    // a legitimate join write now touches it.
    //
    // Residual (accepted, display-only): since no rule can inspect the
    // userId field INSIDE a member object without filter(), a joiner who
    // possesses the real invite code could append a members entry naming
    // someone else while adding their OWN uid to memberIds. That grants no
    // access they weren't already entitled to (they hold the code, and
    // memberIds — the only array any rule authorizes against — still gains
    // exactly their own uid and evicts nobody); the impact is limited to a
    // wrong displayName rendering in the members list.
    function isJoining(householdData) {
      return request.auth != null &&
        request.resource.data.members.size() == householdData.members.size() + 1 &&
        request.resource.data.members.hasAll(householdData.members) &&
        request.resource.data.memberIds.size() == householdData.memberIds.size() + 1 &&
        request.resource.data.memberIds.hasAll(householdData.memberIds) &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.joinCodeUsed == householdData.inviteCode &&
        request.resource.data.diff(householdData).affectedKeys().hasOnly(['members', 'memberIds', 'joinCodeUsed']);
    }

    // Gates every pet subcollection (and, per this plan, every later
    // record-type subcollection nested under a household) for the rest of
    // Plan 2. Unlike isJoining above, there's no untrusted-non-member path
    // to defend against here: every caller of these rules is already an
    // existing household member acting within their own household, so a
    // plain membership check via a cross-document get() on the ancestor
    // household doc is sufficient — no hasAll/diff hijack protection is
    // needed because there's no asymmetric trust boundary to cross.
    //
    // Membership is read from the denormalized `memberIds` array — see the
    // long comment on isMember above for why `members.filter(...)` had to go.
    //
    // The preceding exists() call was dropped (final-review fix wave): it
    // was a redundant second billed document read of the very document the
    // get() below already fetches. get() on a missing document yields no
    // usable `.data`, so this expression cannot evaluate to true for a
    // nonexistent household under any circumstance — whether the runtime
    // treats it as null-dereference error or as a plain false, Firestore
    // denies the request either way (rule-evaluation errors are denials).
    // The check therefore still fails closed, at half the read cost.
    function isHouseholdMember(householdId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Sub-project A of Plan 9. A sitter's read grant lives at a document ID
    // equal to their own uid — this is what makes every check below a
    // single known-path get(), the same idiom isHouseholdMember uses, with
    // no query needed. get() on a missing document errors, which Firestore
    // treats as a denial — same fail-closed reasoning as isHouseholdMember,
    // so there is no explicit "grant exists" check below. Each function
    // reads the grant document exactly once (a `let` binding, not a
    // repeated get() per field) — referencing sitterGrant(...) three times
    // in one expression would otherwise cost three separate reads per check.
    function isValidSitterForPet(householdId, petId) {
      let grant = get(/databases/$(database)/documents/households/$(householdId)/sitterAccess/$(request.auth.uid)).data;
      return request.auth != null &&
        grant.revoked == false &&
        grant.expiresAt > request.time.toMillis() &&
        petId in grant.petIds;
    }

    // For events/vets, which carry petIds as a field rather than being
    // nested under one pet.
    function isValidSitterForAnyPet(householdId, petIds) {
      let grant = get(/databases/$(database)/documents/households/$(householdId)/sitterAccess/$(request.auth.uid)).data;
      return request.auth != null &&
        grant.revoked == false &&
        grant.expiresAt > request.time.toMillis() &&
        grant.petIds.hasAny(petIds);
    }

    // Used only by sitterAccess's own create rule below — a `let` inside a
    // named function (Firestore rules only allows `let` bindings inside a
    // function body, never inline within an `allow` expression itself, so
    // this cannot be written directly in the match block below). One get(),
    // not three, for the same reason as the functions above.
    function matchesSitterInviteCode(code, householdId, petIds, expiresAt) {
      let inviteCode = get(/databases/$(database)/documents/sitterInviteCodes/$(code)).data;
      return inviteCode.householdId == householdId &&
        inviteCode.petIds == petIds &&
        inviteCode.expiresAt == expiresAt;
    }

    match /households/{householdId} {
      allow read: if isMember(resource.data);
      // Fourth site of the invalid `.filter()` idiom (see isMember above);
      // rewritten the same way. A creator must name themselves in the new
      // document's memberIds, so nobody can create a household they are not
      // a member of. The keys()/size() clauses restore a shape guarantee
      // that was implicit in the old `.filter()`-based check (which
      // necessarily dereferenced `members`, so a doc missing it could never
      // pass): `members` must exist and stay in lockstep (same element
      // count) with `memberIds` from the moment of creation, matching what
      // householdService.ts's createHousehold always writes. This is a
      // self-inflicted-only guarantee (a caller can only ever malform their
      // own new household document) — it doesn't defend against another
      // user, but it keeps the two arrays' invariant enforced everywhere,
      // not just from Plan 2 onward.
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.keys().hasAll(['members', 'memberIds']) &&
        request.resource.data.members.size() == request.resource.data.memberIds.size();
      allow update: if isMember(resource.data) || isJoining(resource.data);
      allow delete: if false;
    }

    match /households/{householdId}/pets/{petId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly([
          'id', 'householdId', 'name', 'species', 'speciesOther', 'breed',
          'birthDate', 'birthDatePrecision', 'approximateAgeMonths',
          'arrivalDate', 'arrivalDatePrecision', 'photoUrl', 'colorKey',
          'sex', 'neutered', 'colorMarkings', 'livingEnvironment',
          'microchipProvider', 'microchipNumber', 'microchipDate', 'microchipRegistry',
          'customFields', 'status'
        ]);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/pets/{petId}/vaccines/{vaccineId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'petId', 'name', 'dateGiven', 'nextDueDate', 'vetName']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/pets/{petId}/medications/{medicationId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'petId', 'name', 'dosage', 'schedule', 'startDate', 'endDate', 'log']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/pets/{petId}/weightLogs/{logId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'petId', 'date', 'weight']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/pets/{petId}/expenses/{expenseId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'petId', 'date', 'category', 'amountCents', 'note']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/pets/{petId}/vetVisits/{visitId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'petId', 'date', 'reason', 'notes', 'followUpDate']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    // Household-level (not per-pet) collection — a single calendar entry can
    // span multiple pets (petIds), e.g. one vet trip covering two pets.
    match /households/{householdId}/events/{eventId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForAnyPet(householdId, resource.data.petIds);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'householdId', 'petIds', 'type', 'title', 'notes', 'date', 'status']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    // Household-level (not per-pet) collection, matching events' precedent —
    // a vet clinic can serve multiple pets in the household (petIds).
    match /households/{householdId}/vets/{vetId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForAnyPet(householdId, resource.data.petIds);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly([
          'id', 'householdId', 'clinicName', 'doctorName', 'address', 'phone',
          'openingHours', 'speciality', 'isEmergency24h', 'notes', 'petIds'
        ]);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    // Household-level (not per-pet, not tied to a specific vet visit) —
    // matching vets'/events' precedent. pages is documents' subcollection:
    // one Firestore document per photo is the actual fix for the old
    // VetVisit.documentUrls array's 1 MiB-per-document failure mode.
    match /households/{householdId}/documents/{documentId} {
      allow read: if isHouseholdMember(householdId) || isValidSitterForPet(householdId, resource.data.petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly([
          'id', 'householdId', 'petId', 'title', 'category', 'date',
          'sourceVisitId', 'pageCount', 'createdAt'
        ]);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    match /households/{householdId}/documents/{documentId}/pages/{pageId} {
      allow read: if isHouseholdMember(householdId) ||
        isValidSitterForPet(householdId, get(/databases/$(database)/documents/households/$(householdId)/documents/$(documentId)).data.petId);
      allow create: if isHouseholdMember(householdId) &&
        request.resource.data.keys().hasOnly(['id', 'order', 'photoUrl']);
      allow update: if isHouseholdMember(householdId);
      allow delete: if isHouseholdMember(householdId);
    }

    // Sub-project A of Plan 9. Document ID == the sitter's own uid — see
    // isValidSitterForPet() above for why.
    match /households/{householdId}/sitterAccess/{sitterUid} {
      // Direct-path access: any household member managing sitters, or the
      // sitter reading their own grant.
      allow get: if isHouseholdMember(householdId) || (request.auth != null && request.auth.uid == sitterUid);
      // collectionGroup query access (subscribeToMySitterGrants): provable
      // per-document since the query's own where('sitterUid','==',uid)
      // clause matches this condition exactly — the same reasoning
      // firestore.rules already documents for every other query in this
      // file, just satisfied instead of failed this time.
      allow list: if request.auth != null && resource.data.sitterUid == request.auth.uid;
      // The sitter creates their own grant by redeeming a code — the write
      // must exactly match what that code specifies, so a sitter can never
      // grant themselves broader pets or a later expiry than the code
      // allows. This is the same "cross-check against the exact document
      // driving this write" pattern isJoining() uses for joinCodeUsed.
      allow create: if request.auth != null && request.auth.uid == sitterUid &&
        request.resource.data.sitterUid == sitterUid &&
        request.resource.data.householdId == householdId &&
        request.resource.data.revoked == false &&
        request.resource.data.keys().hasOnly(['sitterUid', 'householdId', 'petIds', 'expiresAt', 'revoked', 'code']) &&
        request.resource.data.code is string &&
        matchesSitterInviteCode(request.resource.data.code, householdId, request.resource.data.petIds, request.resource.data.expiresAt);
      // Revoking early: any household member can flip revoked to true, and
      // only that field — no other field on an existing grant is ever
      // updatable via this rule.
      allow update: if isHouseholdMember(householdId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) &&
        request.resource.data.revoked == true;
      allow delete: if false;
    }

    // Maps a shareable sitter-invite code to what it grants, mirroring
    // inviteCodes exactly: allow get ONLY, never list (see inviteCodes'
    // own comment for why an unrestricted list would let any signed-in
    // user dump every code -> household mapping).
    match /sitterInviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.keys().hasOnly(['householdId', 'petIds', 'expiresAt']) &&
        request.resource.data.expiresAt > request.time.toMillis();
      allow update: if false;
      allow delete: if false;
    }

    // Maps a shareable invite code to its household ID. Readable by any
    // signed-in user — that's the point: it's how joinHousehold (Task 4)
    // finds a household without needing read access to the household
    // document itself, which a non-member never has. A direct query
    // against `households` filtered by inviteCode would be rejected by
    // Firestore for a non-member (list/query rules must hold for every
    // potentially-matching document, not just the one that actually
    // matches), so this lookup collection exists specifically to make
    // joining possible at all.
    match /inviteCodes/{code} {
      // `allow get` ONLY — deliberately no `allow list` (and no combined
      // `allow read`, which grants both). This condition doesn't reference
      // resource.data, so it's trivially provable for every document in
      // the collection; if it were spelled as `allow read`, Firestore
      // would permit an unrestricted `list`/`getDocs(collection(...))`
      // against the whole collection, letting any signed-in user dump
      // every code -> householdId mapping and then join ANY household by
      // supplying that household's own real invite code back to it via
      // `joinCodeUsed` (isJoining() DOES now verify code possession — see
      // that function's comment — but dumping this collection would still
      // hand an attacker every household's actual code, defeating the
      // point just as thoroughly). Restricting to `get` limits reads to
      // exactly what joinHousehold does:
      // `getDoc(doc(db, 'inviteCodes', code))` for one known code.
      allow get: if request.auth != null;

      // Create is intentionally NOT scoped to verify the caller owns the
      // referenced household. Doing that robustly with pure security
      // rules is hard here because both documents (household + invite
      // code) are written together in one batch (see householdService.ts):
      // an interior get() on /households/$(householdId) evaluated
      // mid-batch is not guaranteed to see that household doc as already
      // committed — Firestore's exact rule-evaluation semantics for
      // reads-of-sibling-writes within the same batch could not be
      // verified in this sandbox (no emulator/JRE available) and should
      // not be assumed either way without a real test. Left as a residual,
      // now-low-severity gap: a signed-in user could still create an
      // inviteCodes/{code} -> {householdId: <arbitrary>} mapping for a
      // household they don't own, but with `list` removed above they have
      // no way to discover which household IDs exist to target, and
      // creating a bogus mapping does not by itself grant any access to
      // `households/{householdId}` (isMember/isJoining gate that
      // separately). Whoever picks this up next: verify get()-during-batch
      // rule semantics against a real emulator before attempting to close
      // this further.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['householdId', 'memberCount']);

      // memberCount is a denormalized mirror of the household's member
      // count (Plan 7), read here by a non-member client (joinHousehold)
      // specifically so it can show a friendly "household is full" message
      // BEFORE attempting to join — the joining client has no read grant on
      // the household document itself (see the comment above), so this is
      // the only place that count can come from. This is intentionally an
      // advisory-only soft cap, the same tier as Plan 4's custom-field
      // limit (also not rules-enforced): a signed-in user could in
      // principle write an inaccurate count here, but that only affects
      // what gets DISPLAYED before a join attempt, not who can actually
      // join a household they don't belong to — isMember/isJoining on the
      // household document itself are the real access-control boundary and
      // are completely unaffected by this field. householdId is kept
      // immutable so this rule can never be used to repoint a code at a
      // different household.
      // The memberCount is int / >= 0 checks (final-review fix wave) are a
      // cheap complement, not a replacement, for the real fix to memberCount
      // drift: removeMember (householdService.ts) now writes the caller-
      // supplied absolute remaining count instead of increment(-1), and
      // HouseholdScreen's reconcileMemberCount self-heals the stored value
      // against the true `members.length` every time any member opens the
      // Household tab. This rule-level floor just rejects the most obviously
      // malformed writes (a negative or non-integer value) outright.
      allow update: if request.auth != null &&
        request.resource.data.householdId == resource.data.householdId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        request.resource.data.memberCount is int &&
        request.resource.data.memberCount >= 0;
      allow delete: if false;
    }

    // Maps a signed-in user to the household they belong to, so the app can
    // answer "which household am I in" on a fresh launch via a single-
    // document get() (users/{uid}) instead of a query — the same reasoning
    // as inviteCodes above: a where('members', 'array-contains', ...)-style
    // query can't be proven against every structurally-matching document
    // for a non-member, so Firestore would reject it outright.
    match /users/{userId} {
      // A single-document get() by known uid, not a query — mirrors the
      // inviteCodes pattern from Plan 1. Only the user themselves may ever
      // read their own pointer; list is explicitly denied so this can never
      // be enumerated to discover other users' household membership.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      // Only fires when the document does not yet exist (Firestore classifies
      // a write to an existing doc as `update`, not `create`) — so a user who
      // already belongs to a household cannot overwrite their pointer via this
      // rule. A STILL-ACTIVE member still can't overwrite their pointer this
      // way either (see `allow update` below) — only a removed member can,
      // via the recovery-path rule this plan adds.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['householdId']);

      // Recovery path (Plan 7) for the standing "a removed household member
      // has no way back in" gap: a removed member's pointer still names
      // their OLD household. `resource` below is that EXISTING document
      // (pre-write) — this rule lets a user overwrite their OWN pointer
      // only once they are no longer in the memberIds of the household it
      // currently names, so a still-active member cannot touch their own
      // pointer this way (they'd have to actually be removed first). This
      // depends only on the CURRENT committed state of the household
      // document being read, never on any other write in the same batch —
      // removeMember (householdService.ts) does not touch this document at
      // all; the removed user's own next createHousehold/joinHousehold call
      // is what exercises this rule, driven by the exact same
      // batch.set(doc(db,'users',userId), {householdId}) call those
      // functions already make (Firestore classifies a write to an existing
      // doc as `update` regardless of set() vs update(), so no client code
      // change was needed for this — see the comment on `allow get` above).
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['householdId']) &&
        !(request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberIds);
      allow delete: if false;
    }
  }
}
