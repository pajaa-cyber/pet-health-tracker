rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors firestore.rules' isHouseholdMember(householdId) helper (Task 2 /
    // Pet Records Core), but expressed in the Storage rules language, which
    // has no local functions scoped to a match block the way Firestore rules
    // do — the check is inlined directly in the allow clause instead.
    //
    // Storage rules calling into Firestore via firestore.get()/firestore.exists()
    // is a documented cross-service feature (see
    // https://firebase.google.com/docs/storage/security/user-security#security-rules-cross-service),
    // used here so a vet visit document upload/read is gated by the SAME
    // household-membership data (households/{householdId}.memberIds) that
    // firestore.rules already enforces for the vetVisits document itself —
    // there is deliberately no separate/duplicated membership model for
    // Storage. NOTE: this specific cross-service syntax (path literal form
    // required by firestore.get()/firestore.exists(), as opposed to the
    // $(database)-style path interpolation Firestore rules use for get()/
    // exists() against its own database) could not be verified against a
    // real emulator in this sandbox (no JRE available, same standing
    // constraint noted throughout this project's rules files) — confirm via
    // `firebase emulators:exec --only firestore,storage "..."` on a machine
    // with Java before trusting this in production.
    // Membership is read from the denormalized `memberIds: string[]` array
    // on the household document, NOT from `members` — the previous
    // `members.filter(m => m.userId == request.auth.uid).size() > 0` spelling
    // is not valid rules syntax (no filter(), no lambdas — see the long
    // comment on isMember() in firestore.rules for the full finding). The
    // `in` operator over a list of strings is the standard documented form.
    // Read and write are split so uploads can additionally be bounded in
    // size and constrained to images (a vet-visit document is photographed
    // paperwork), which keeps an authenticated member from filling the
    // bucket with arbitrary large binaries; reads stay a plain membership
    // check since request.resource is not meaningful for them. Side effect
    // to be aware of: `delete` is also classified as a `write`, and on a
    // delete request.resource is null, so the size/contentType clauses make
    // deletes fail closed. Nothing in the app deletes storage objects today
    // (VetVisitDocumentsScreen only uploads); whoever adds a "remove
    // document" feature must split `delete` out into its own allow clause
    // with the membership check alone.
    match /households/{householdId}/pets/{petId}/vetVisits/{visitId}/{fileName} {
      allow read: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Same membership/size/content-type shape as vetVisits documents above,
    // for the pet's own profile photo. A single fixed filename (photo.jpg)
    // rather than one-per-upload, since a pet has exactly one current
    // photo — a new upload overwrites the previous one at the same path.
    match /households/{householdId}/pets/{petId}/photo.jpg {
      allow read: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberIds &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
